<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MobileMap" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- 图层管理对话框 Tab 文本样式 -->
    <style name="LayerManageTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 主界面启动主题（启动页已合并到主界面）：窗口背景与状态栏/导航栏颜色与加载遮罩一致，
         消除主界面冷启动预览窗口的背景/紫色状态栏闪动（随后由 util.enableFullscreen 接管沉浸全屏） -->
    <style name="Theme.MobileMap.Main" parent="Theme.MobileMap">
        <item name="android:windowBackground">@color/activity_background</item>
        <item name="android:statusBarColor">@color/activity_background</item>
        <item name="android:navigationBarColor">@color/activity_background</item>
    </style>
</resources>