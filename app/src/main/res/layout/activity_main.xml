<?xml version="1.0" encoding="utf-8"?>
<!-- MainActivity 布局：全屏承载 globecore 的 NativeMapView，叠加「地图导航」类控件。
     按键放置位置对齐主界面 activity_main.xml：改用 ConstraintLayout，左侧 bias 0.7 放测量入口、
     右侧 bias 0.7 放拍照、右上放图层管理、左上放 2D/3D 视图模式切换、左下放设置/定位/轨迹、右下放注记/缩放面板；
     测量采集子控件（撤销/中心点/结束）单独放到屏幕下方居中。
     2D 墨卡托恒正北；3D 支持双指旋转方位角，故左上栏备指北针复位键（heading 非零时才显示）。 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.zys.globecore.NativeMapView
        android:id="@+id/jni_map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 地图中心十字准星（复用主界面 CrossView，指示当前地图中心点） -->
    <com.zys.mobilemap.control.CrossView
        android:id="@+id/jni_map_cross"
        android:layout_width="30px"
        android:layout_height="30px"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 左上：指北针复位键（视图模式 2D/3D 已改由设置页控制，此处不再放切换键）。heading 非零且 3D 时才显示。 -->
    <LinearLayout
        android:id="@+id/jni_lay_lt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="50dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 指北针复位：3D 双指旋转后 heading 非零时显示（MainActivity 轮询回调控显隐），点击回正北。
             文字硬编码避免改 strings.xml。 -->
        <TextView
            android:id="@+id/jni_map_compass"
            android:layout_width="@dimen/main_icon_size"
            android:layout_height="@dimen/main_icon_size"
            android:background="@color/main_icon_bg"
            android:gravity="center"
            android:text="指北"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 左侧中部（对齐主界面 lay_lm，vertical_bias 0.7）：测量工具入口。
         采集子控件（撤销/中心点/结束）已移至屏幕下方居中容器。 -->
    <LinearLayout
        android:id="@+id/jni_lay_lm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/jni_lay_lb"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.7">

        <ImageView
            android:id="@+id/jni_map_measure"
            android:layout_width="@dimen/main_icon_size"
            android:layout_height="@dimen/main_icon_size"
            android:background="#a0dddddd"
            android:padding="5.0dp"
            android:src="@drawable/nav_measure" />
    </LinearLayout>

    <!-- 右上（对齐主界面 lay_top）：图层管理。
         图层管理对话框的「地图源」页签用于切换底图（可见性驱动，即时生效）。 -->
    <LinearLayout
        android:id="@+id/jni_lay_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="10dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 图层管理按钮（级别可见性数字展示在图层管理界面的级别按键上，此处不带徽标） -->
        <ImageView
            android:id="@+id/jni_map_layer_manage"
            android:layout_width="@dimen/main_icon_size"
            android:layout_height="@dimen/main_icon_size"
            android:background="@color/main_icon_bg"
            android:padding="5.0dp"
            android:contentDescription="@string/jni_map_layer_manage"
            android:src="@drawable/nav_overlay_manager" />
    </LinearLayout>

    <!-- 右侧中部（对齐主界面 linearLayout2，vertical_bias 0.7）：拍照入口。
         拍照复用 MediaCaptureHelper（不依赖原底层库）。 -->
    <LinearLayout
        android:id="@+id/jni_lay_photo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/jni_lay_rb"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.7">

        <ImageView
            android:id="@+id/jni_map_photo"
            android:layout_width="@dimen/main_icon_size"
            android:layout_height="@dimen/main_icon_size"
            android:background="@color/main_icon_bg"
            android:padding="5.0dp"
            android:src="@drawable/nav_quick_pic" />
    </LinearLayout>

    <!-- 左下（对齐主界面 lay_lb）：设置 + 回到当前位置 + 轨迹工具栏（采集子控件开始/暂停/停止默认隐藏）。
         轨迹采集经定位监听追加点、实时走 overlay live 层渲染。 -->
    <LinearLayout
        android:id="@+id/jni_lay_lb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="60dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/jni_map_setting"
            android:layout_width="@dimen/main_icon_size"
            android:layout_height="@dimen/main_icon_size"
            android:background="@color/main_icon_bg"
            android:padding="5.0dp"
            android:contentDescription="@string/jni_map_setting"
            android:src="@drawable/nav_settings" />

        <ImageView
            android:id="@+id/jni_map_locate"
            android:layout_width="@dimen/main_icon_size"
            android:layout_height="@dimen/main_icon_size"
            android:layout_marginTop="5.0dip"
            android:background="@color/main_icon_bg"
            android:padding="6dp"
            android:contentDescription="@string/jni_map_locate"
            android:src="@drawable/nav_location" />

        <ImageView
            android:id="@+id/jni_map_track_start"
            android:layout_width="@dimen/main_icon_size"
            android:layout_height="@dimen/main_icon_size"
            android:layout_marginTop="10.0dip"
            android:background="#a0dddddd"
            android:padding="5.0dp"
            android:src="@drawable/nav_ic_start"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/jni_map_track_pause"
            android:layout_width="@dimen/main_icon_size"
            android:layout_height="@dimen/main_icon_size"
            android:layout_marginTop="5.0dip"
            android:background="#a0dddddd"
            android:padding="5.0dp"
            android:src="@drawable/nav_ic_pause"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/jni_map_track_stop"
            android:layout_width="@dimen/main_icon_size"
            android:layout_height="@dimen/main_icon_size"
            android:layout_marginTop="5.0dip"
            android:background="#a0dddddd"
            android:padding="5.0dp"
            android:src="@drawable/nav_ic_stop"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/jni_map_track"
            android:layout_width="@dimen/main_icon_size"
            android:layout_height="@dimen/main_icon_size"
            android:layout_marginTop="10.0dip"
            android:background="#a0dddddd"
            android:padding="5.0dp"
            android:src="@drawable/nav_routes" />
    </LinearLayout>

    <!-- 右下（对齐主界面 lay_rb）：注记显隐开关 + 缩放面板（放大 / 级别数字 / 缩小） -->
    <LinearLayout
        android:id="@+id/jni_lay_rb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="60dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 注记图层显隐开关（图标随可见性切换，对齐主界面 main_iv_isCIA） -->
        <ImageView
            android:id="@+id/jni_map_annotation"
            android:layout_width="@dimen/main_icon_size"
            android:layout_height="@dimen/main_icon_size"
            android:layout_marginBottom="32dp"
            android:background="@color/main_icon_bg"
            android:contentDescription="@string/main_annotation_toggle"
            android:src="@drawable/nav_ic_cia_open" />

        <!-- 放大按键：图标资源沿用主界面映射（nav_zoom_out 为「+」字形），保证视觉一致 -->
        <ImageView
            android:id="@+id/jni_map_zoom_in"
            android:layout_width="@dimen/main_icon_size"
            android:layout_height="@dimen/main_icon_size"
            android:background="@color/main_icon_bg"
            android:padding="5.0dp"
            android:contentDescription="@string/jni_map_zoom_in"
            android:src="@drawable/nav_zoom_out" />

        <!-- 当前级别数字（由相机高度换算，与主界面同源 MercatorZoom.altitudeToLevel） -->
        <TextView
            android:id="@+id/jni_map_level"
            android:layout_width="36dp"
            android:layout_height="10dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="8dip" />

        <!-- 缩小按键：图标资源沿用主界面映射（nav_zoom_in 为「-」字形） -->
        <ImageView
            android:id="@+id/jni_map_zoom_out"
            android:layout_width="@dimen/main_icon_size"
            android:layout_height="@dimen/main_icon_size"
            android:background="@color/main_icon_bg"
            android:padding="5.0dp"
            android:contentDescription="@string/jni_map_zoom_out"
            android:src="@drawable/nav_zoom_in" />
    </LinearLayout>

    <!-- 屏幕下方居中：测量采集子控件（撤销 / 中心点 / 结束），默认隐藏，进入测量模式时显示。
         由 setMeasureControlsVisible 按 ID 逐个切换可见性，横向排列于状态栏上方居中。 -->
    <LinearLayout
        android:id="@+id/jni_lay_measure_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/jni_map_measure_undo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:textAlignment="center"
            android:padding="0dp"
            android:text="撤销"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/jni_map_measure_center"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:textAlignment="center"
            android:padding="0dp"
            android:text="中心点"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/jni_map_measure_finish"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:textAlignment="center"
            android:padding="0dp"
            android:text="结束"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 底部状态栏（单行）：定位文本 wrap_content 优先完整显示（含海拔段），中心文本占剩余宽度（0dp+weight）；
         空间不足时只有中心文本尾部省略，定位文本不被截断。 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#80111111"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/jni_map_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="start|center_vertical"
            android:paddingStart="8.0dip"
            android:paddingEnd="8.0dip"
            android:singleLine="true"
            android:textColor="#ffffffff"
            android:textSize="12.0sp" />

        <TextView
            android:id="@+id/jni_map_center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:minWidth="0dp"
            android:paddingStart="8.0dip"
            android:paddingEnd="8.0dip"
            android:singleLine="true"
            android:textColor="#ffffffff"
            android:textSize="12.0sp" />
    </LinearLayout>

    <!-- 大数据矢量加载提示胶囊（顶部居中）：仅在巨层首载/相机静止重载工作超过延迟阈值时显示
         （防快速加载闪烁），MapLayerManager 轮询 native hasVectorLoading 完成后隐藏；不拦截手势。 -->
    <LinearLayout
        android:id="@+id/jni_map_vector_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:background="#B3111111"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:indeterminateOnly="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/vector_loading_hint"
            android:textColor="#ffffffff"
            android:textSize="12.0sp" />
    </LinearLayout>

    <!-- 启动加载遮罩：盖住 native/proj/文档初始化与首屏瓦片异步加载的白屏，
         初始化完成（或安全超时）后淡出。MainActivity 升为主入口后自行承担启动初始化，故需自带遮罩。 -->
    <LinearLayout
        android:id="@+id/jni_map_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:gravity="center"
            android:textColor="#131313"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/main_loading_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/splash_loading"
            android:textColor="#666666"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
