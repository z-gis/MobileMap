<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">


    <!-- 左侧：图层样式图标 -->
    <ImageView
        android:id="@+id/item_layer_iv_icon"
        android:layout_width="72dp"
        android:layout_height="36dp"
        app:tint="#757575"
        android:contentDescription="@string/layer_icon_desc" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <!-- 右侧上层：图层名称，点击选中高亮 -->
        <TextView
            android:id="@+id/item_layer_tv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- 右侧下层：SQL 查询（仅 shp）/ 级别可见性（图标+生效级别数字徽标）/ 缩放到 / 可见性切换 / 图层信息 / 移除图层 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">

            <ImageView
                android:id="@+id/item_layer_iv_sql"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_sql_query"
                android:visibility="gone"
                app:tint="#757575"
                android:contentDescription="@string/layer_sql_query" />

            <!-- 级别可见性：矢量层显隐由代码切到外层容器；右下角徽标显示当前生效级别（未限制时隐藏） -->
            <FrameLayout
                android:id="@+id/item_layer_fl_level"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="16dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/item_layer_iv_level"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_display_level"
                    app:tint="#757575"
                    android:contentDescription="@string/layer_level_visibility" />

                <TextView
                    android:id="@+id/item_layer_tv_level_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_level_badge"
                    android:gravity="center"
                    android:minWidth="13dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:textColor="#E53935"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageView
                android:id="@+id/item_layer_iv_zoom_to"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_zoom_to"
                app:tint="#757575"
                android:contentDescription="@string/media_zoom_to" />

            <ImageView
                android:id="@+id/item_layer_iv_visibility"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/layer_icon_desc" />

            <ImageView
                android:id="@+id/item_layer_iv_info"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_info"
                app:tint="#757575"
                android:contentDescription="@string/layer_icon_desc" />

            <ImageView
                android:id="@+id/item_layer_iv_delete"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_delete"
                app:tint="#757575"
                android:contentDescription="@string/layer_icon_desc" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>