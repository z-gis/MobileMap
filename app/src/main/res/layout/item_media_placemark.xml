<?xml version="1.0" encoding="utf-8"?>
<!--
  分组下的点位子项行。paddingStart 刻意大于分组行行首：item_media_group.xml 的文字左边缘为
  8dp(padding) + 28dp(折叠箭头) + 4dp(margin) = 40dp，子项对齐到同一列（相对分组行的 8dp
  已缩进 32dp），形成父子层级。不继续加深是为保住名称可用宽度：默认点名
  “拍照 yyyy-MM-dd HH:mm:ss”在 14sp 下约 159dp，360dp 屏减去右侧控件后约剩 164dp，刚好放得下
  （调此处前先算清分组头的列位置）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="40dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_media_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#131313"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/item_media_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#888888"
            android:textSize="11sp"/>
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/item_media_visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"/>

    <ImageView
        android:id="@+id/item_media_zoom"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/media_zoom_to"
        android:padding="6dp"
        android:src="@drawable/ic_zoom_to"/>

    <ImageView
        android:id="@+id/item_media_delete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:padding="6dp"
        android:src="@drawable/ic_delete"/>

</LinearLayout>
