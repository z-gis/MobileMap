<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 顶部：要素名称 + 关闭 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/feature_detail_tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/feature_detail_btn_survey_entry"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText"
            xmlns:tools="http://schemas.android.com/tools" />

        <!-- 顶部“样地调查”按键：紧邻编辑左侧，始终可见（不受编辑门控与标签页切换影响） -->
        <TextView
            android:id="@+id/feature_detail_btn_survey_entry"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_toStartOf="@id/feature_detail_btn_edit"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="样地调查"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:ignore="HardcodedText"
            xmlns:tools="http://schemas.android.com/tools" />

        <!-- 顶部“编辑”按键（文本式）：editButtonVisible 时可见，点击后进入可编辑态（属性可改），取代原全局调查模式门控 -->
        <TextView
            android:id="@+id/feature_detail_btn_edit"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_toStartOf="@id/feature_detail_tv_close"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="编辑"
            android:textColor="#2196F3"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:ignore="HardcodedText"
            xmlns:tools="http://schemas.android.com/tools" />

        <TextView
            android:id="@+id/feature_detail_tv_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="#757575"
            android:textSize="18sp"
            tools:ignore="HardcodedText"
            xmlns:tools="http://schemas.android.com/tools" />
    </RelativeLayout>

    <!-- 要素基本信息卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_feature_group"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/feature_detail_tv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#212121"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/feature_detail_tv_layer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#616161"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/feature_detail_tv_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#616161"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 标签页：样式 / 属性 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/feature_detail_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        app:tabGravity="fill"
        app:tabIndicatorColor="#2196F3"
        app:tabMode="fixed"
        app:tabSelectedTextColor="#2196F3"
        app:tabTextColor="#757575" />

    <!-- 样式页 -->
    <ScrollView
        android:id="@+id/feature_detail_page_style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 面样式 -->
            <TextView
                android:id="@+id/feature_detail_tv_fill_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="面样式"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText"
                xmlns:tools="http://schemas.android.com/tools" />

            <LinearLayout
                android:id="@+id/feature_detail_ll_fill_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_feature_group"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- 第一行：左半填充颜色 + 右半填充开关（关闭开关时面仅描边不填充）；固定行高，两列等高顶边对齐 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="填充颜色："
                            android:textColor="#424242"
                            android:textSize="14sp"
                            tools:ignore="HardcodedText" />

                        <ImageView
                            android:id="@+id/feature_detail_iv_fill_color"
                            android:layout_width="100dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="8dp"
                            android:background="#4A90D9"
                            android:contentDescription="填充颜色"
                            android:src="@drawable/bg_swatch_border"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/feature_detail_cb_fill_enabled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="填充"
                            android:textSize="14sp"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 第二行：左半描边颜色 + 右半线宽步进；固定行高，与上一行顶边对齐 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="描边颜色："
                            android:textColor="#424242"
                            android:textSize="14sp"
                            tools:ignore="HardcodedText" />

                        <ImageView
                            android:id="@+id/feature_detail_iv_outline_color"
                            android:layout_width="100dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="5dp"
                            android:background="#1A4FA0"
                            android:contentDescription="描边颜色"
                            android:src="@drawable/bg_swatch_border"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_marginStart="10dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="线宽："
                            android:textColor="#424242"
                            android:textSize="14sp"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/feature_detail_btn_width_minus"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:text="−"
                            android:textSize="18sp"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/feature_detail_tv_width_value"
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="#212121"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/feature_detail_btn_width_plus"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:text="+"
                            android:textSize="18sp"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 标识图标（点要素样式）：默认隐藏，点要素时显示并程序填充图标网格 -->
            <TextView
                android:id="@+id/feature_detail_tv_icon_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="标识图标"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:ignore="HardcodedText"
                xmlns:tools="http://schemas.android.com/tools" />

            <LinearLayout
                android:id="@+id/feature_detail_ll_icon_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_feature_group"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone" />

            <!-- 字体设置（标注）：图层样式模式下 kml 等不开放标注设置时整区隐藏 -->
            <TextView
                android:id="@+id/feature_detail_tv_label_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="标注设置"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText"
                xmlns:tools="http://schemas.android.com/tools" />

            <LinearLayout
                android:id="@+id/feature_detail_ll_label_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_feature_group"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- 标注开关：关闭时隐藏下方标注控件，字段/颜色/大小状态保持不变，重新打开即恢复 -->
                <CheckBox
                    android:id="@+id/feature_detail_cb_label_enabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="标注"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText" />

                <!-- 标注控件容器：随标注开关联动显隐，关闭时仅隐藏不清空状态 -->
                <LinearLayout
                    android:id="@+id/feature_detail_ll_label_fields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="标注字段："
                        android:textColor="#424242"
                        android:textSize="14sp"
                        tools:ignore="HardcodedText"
                        xmlns:tools="http://schemas.android.com/tools" />

                    <Spinner
                        android:id="@+id/feature_detail_sp_label_field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- 字体颜色（左半）+ 字体轮廓（右半）同一行；固定行高，两列等高顶边对齐 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="字体颜色："
                            android:textColor="#424242"
                            android:textSize="14sp"
                            tools:ignore="HardcodedText" />

                        <ImageView
                            android:id="@+id/feature_detail_iv_label_color"
                            android:layout_width="100dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="5dp"
                            android:background="#212121"
                            android:contentDescription="字体颜色"
                            android:src="@drawable/bg_swatch_border"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="字体轮廓："
                            android:textColor="#424242"
                            android:textSize="14sp"
                            tools:ignore="HardcodedText" />

                        <CheckBox
                            android:id="@+id/feature_detail_cb_label_outline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:minHeight="0dp" />

                        <ImageView
                            android:id="@+id/feature_detail_iv_label_outline_color"
                            android:layout_width="100dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="4dp"
                            android:background="#000000"
                            android:contentDescription="字体轮廓颜色"
                            android:src="@drawable/bg_swatch_border"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="字体大小："
                        android:textColor="#424242"
                        android:textSize="14sp"
                        tools:ignore="HardcodedText"
                        xmlns:tools="http://schemas.android.com/tools" />

                    <TextView
                        android:id="@+id/feature_detail_btn_size_minus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="−"
                        android:gravity="center"
                        android:textSize="18sp"
                        tools:ignore="HardcodedText"
                        xmlns:tools="http://schemas.android.com/tools" />

                    <TextView
                        android:id="@+id/feature_detail_tv_size_value"
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="#212121"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/feature_detail_btn_size_plus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="+"
                        android:gravity="center"
                        android:textSize="18sp"
                        tools:ignore="HardcodedText"
                        xmlns:tools="http://schemas.android.com/tools" />
                </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 恢复默认 / 保存 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/feature_detail_btn_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="?android:attr/borderlessButtonStyle"
                    android:textColor="@color/black"
                    android:text="恢复默认"
                    tools:ignore="HardcodedText"
                    xmlns:tools="http://schemas.android.com/tools" />

                <Button
                    android:id="@+id/feature_detail_btn_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="?android:attr/borderlessButtonStyle"
                    android:textColor="@color/black"
                    android:layout_marginStart="12dp"
                    android:text="保存"
                    tools:ignore="HardcodedText"
                    xmlns:tools="http://schemas.android.com/tools" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 属性页：固定高度内滚——手势位于列表内滚动属性列表，列表外拖拽回缩弹层 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/feature_detail_page_attrs"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/feature_detail_tv_attr_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="#9E9E9E"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/feature_detail_ll_attr_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_feature_group"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="属性名"
                    android:textColor="#212121"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText"
                    xmlns:tools="http://schemas.android.com/tools" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="属性值"
                    android:textColor="#212121"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText"
                    xmlns:tools="http://schemas.android.com/tools" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/feature_detail_ll_attr_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 保存修改按键：调查模式下属性编辑后有改动时可见，点击写回矢量源文件 -->
            <Button
                android:id="@+id/feature_detail_btn_save_attrs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:text="保存修改"
                android:visibility="gone"
                tools:ignore="HardcodedText"
                xmlns:tools="http://schemas.android.com/tools" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
