<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 顶部：名称 + 操作图标（编辑/分享/删除/关闭） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/photo_sheet_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 重命名：弹「编辑拍照标识」对话框（名称+分组），无点位时隐藏 -->
        <ImageView
            android:id="@+id/photo_sheet_rename"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="重命名"
            android:padding="6dp"
            android:src="@drawable/ic_edit" />

        <ImageView
            android:id="@+id/photo_sheet_share"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="分享"
            android:padding="6dp"
            android:src="@drawable/ic_share" />

        <ImageView
            android:id="@+id/photo_sheet_delete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="删除"
            android:padding="6dp"
            android:src="@drawable/ic_delete" />

        <!-- 关闭（文本 ✕，与其他详情弹层一致） -->
        <TextView
            android:id="@+id/photo_sheet_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#757575"
            android:textSize="18sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <com.zys.mobilemap.control.MaxHeightRecyclerView
        android:id="@+id/photo_sheet_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/photo_sheet_empty"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center"
        android:text="暂无照片"
        android:textColor="#999999"
        android:textSize="14sp"
        android:visibility="gone"/>

</LinearLayout>
