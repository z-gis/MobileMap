<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!-- 相机 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- 允许程序打开网络套接字 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- 后台定位保活：location 型前台服务（息屏/退后台仍持续定位，避免轨迹缺点） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Android 13+ 前台服务常驻通知需通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 存储权限 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_MEDIA_STORAGE"
        tools:ignore="ProtectedPermissions" />

    <!-- 安装APK权限 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 全部文件权限 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="AllFilesAccessPolicy,ScopedStorage" />

    <application
        android:name=".MobileMapApp"
        android:allowBackup="true"
        android:largeHeap="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MobileMap"
        tools:replace="android:allowBackup">
        <!-- 原底层库主界面 MainActivity 及其链路（BaseMapActivity / 原底层库主窗口类 / 各 Model）已整体删除：
             启动入口与外部 ACTION_VIEW 承接均由下方 MainActivity 承担。 -->
        <activity
            android:name=".ui.activity.OpenFileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.AboutActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.HelpActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.PhotoViewerActivity"
            android:exported="false" />
        <activity
            android:name=".survey.SampleSurveyActivity"
            android:exported="false"
            android:theme="@style/Theme.MobileMap" />

        <!-- 原底层库→jni 迁移完成：MainActivity 为程序主入口，承载 globecore 的 NativeMapView，
             作为 LAUNCHER 与外部 ACTION_VIEW 承接者。
             启动加载遮罩盖住初始化阶段（native/proj/文档加载）；singleTask 保证外部拉起复用已运行实例（走 onNewIntent）；
             configChanges 使横竖屏切换不重建 Activity（NativeMapView 自行处理 GL surface 尺寸变化）；
             theme 沿用主界面 Theme.MobileMap.Main，保证启动窗口一致。 -->
        <activity
            android:name=".ui.activity.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.MobileMap.Main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 系统外部打开数据统一由 MainActivity 承接：初始化完成后处理 intent，
                 kml/kmz/zip 按 MIME，shp/dwg/dxf/gpkg 及拍照数据包(mphoto) 按扩展名 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.google-earth.kml+xml" />
                <data android:mimeType="application/vnd.google-earth.kmz" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.shp" />
                <data android:pathPattern=".*\\.dwg" />
                <data android:pathPattern=".*\\.dxf" />
                <data android:pathPattern=".*\\.gpkg" />
                <!-- 拍照数据包（自定义扩展名，实为 zip）：分享后经微信/文件管理器打开回到本 app 导入 -->
                <data android:pathPattern=".*\\.mphoto" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 后台定位保活前台服务（location 型）：轨迹记录期间息屏/退后台保持定位订阅不丢点 -->
        <service
            android:name=".location.BackgroundLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>