<?xml version="1.0" encoding="UTF-8"?>
<!--
  中央电视台总部大楼（CCTV Headquarters, 北京 CBD）—— 3D 立体示意 KML
  ────────────────────────────────────────────────────────────────
  设计意图：贴合本项目 worldwindjni 引擎实际能力（Phase 1 逐顶点高程 + Phase 2 extrude 立体 +
            Phase 3 逐要素配色）制作。引擎仅支持「棱柱拉伸体」，不支持 Collada(.dae)/glTF 真三维模型，
            故此文件是「示意图级」近似，非精确外形：
    - 塔 A / 塔 B：各自为竖直拉伸盒体（extrude=1，relativeToGround，Z=楼顶高程）→ 立为实心体；
    - 顶部连体：一块悬浮水平板（relativeToGround，Z=楼顶，extrude=0）→ 横跨两塔顶、示意空中走廊；
    - 三者围出中央「中空」，还原 CCTV 门形闭合环的拓扑。
  已知失真：真实两塔向内倾斜、顶部为悬挑箱形连体；本引擎棱柱拉伸无法表现斜腿与悬挑，故塔身竖直、连体简化为平板。
  坐标为经纬度（WGS84），高程单位米，相对地面（本环境无 DEM，relativeToGround≈离椭球）。位置为 CBD 近似值，仅示意。
-->
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>CCTV 总部大楼（3D 立体示意）</name>
    <open>1</open>

    <LookAt>
      <longitude>116.48810</longitude>
      <latitude>39.91635</latitude>
      <altitude>400</altitude>
      <heading>-30</heading>
      <tilt>55</tilt>
      <range>900</range>
      <altitudeMode>relativeToGround</altitudeMode>
    </LookAt>

    <!-- 玻璃幕墙钢构：石板蓝填充 + 暖铜色描边。按要素 name 关联（Phase 3）。 -->
    <Style id="cctvBody">
      <LineStyle>
        <color>ff4060a0</color>
        <width>1.5</width>
      </LineStyle>
      <PolyStyle>
        <color>cc8c6e5a</color>
      </PolyStyle>
    </Style>

    <!-- 西南塔楼：竖直拉伸盒体，高约 163 m -->
    <Placemark>
      <name>CCTV Tower A</name>
      <description>西南塔楼（示意，实际向内倾斜）</description>
      <styleUrl>#cctvBody</styleUrl>
      <Polygon>
        <extrude>1</extrude>
        <altitudeMode>relativeToGround</altitudeMode>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              116.487400,39.915850,163
              116.487900,39.915850,163
              116.487900,39.916250,163
              116.487400,39.916250,163
              116.487400,39.915850,163
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>

    <!-- 东北塔楼：对角另一腿，高约 163 m -->
    <Placemark>
      <name>CCTV Tower B</name>
      <description>东北塔楼（示意，实际向内倾斜）</description>
      <styleUrl>#cctvBody</styleUrl>
      <Polygon>
        <extrude>1</extrude>
        <altitudeMode>relativeToGround</altitudeMode>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              116.488300,39.916450,163
              116.488800,39.916450,163
              116.488800,39.916850,163
              116.488300,39.916850,163
              116.488300,39.916450,163
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>

    <!-- 顶部连体：横跨两塔顶的悬浮水平板（不落地 → extrude=0，仅板面示意空中走廊）。 -->
    <Placemark>
      <name>CCTV Sky Bridge</name>
      <description>顶部悬挑连体（示意，实际为箱形悬挑，非平板）</description>
      <styleUrl>#cctvBody</styleUrl>
      <Polygon>
        <extrude>0</extrude>
        <altitudeMode>relativeToGround</altitudeMode>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              116.487400,39.915850,163
              116.488800,39.915850,163
              116.488800,39.916850,163
              116.487400,39.916850,163
              116.487400,39.915850,163
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
        <innerBoundaryIs>
          <LinearRing>
            <coordinates>
              116.487900,39.916250,163
              116.488300,39.916250,163
              116.488300,39.916450,163
              116.487900,39.916450,163
              116.487900,39.916250,163
            </coordinates>
          </LinearRing>
        </innerBoundaryIs>
      </Polygon>
    </Placemark>

  </Document>
</kml>
