<?xml version="1.0" encoding="UTF-8"?>
<!--
  中国名筑 3D 演示集 (China Landmarks 3D Demo)
  ────────────────────────────────────────────────────────────────
  目标：贴合本项目 worldwindjni 引擎已落地的 3D 能力（Phase 1 逐顶点高程 + Phase 2 extrude 立体 +
        Phase 3 逐要素配色），一次演示 5 座中国地标。均为「示意图级」近似，非精确外形：
    1) CCTV 中央电视台总部大楼 (北京 CBD)     —— 两腿竖直盒体 + 顶部带方孔悬浮板，示意门形闭合环
    2) 中国尊 CITIC Tower      (北京 CBD)     —— 5 段方形阶梯收分塔，高 528m
    3) 金茂大厦 Jin Mao Tower  (上海陆家嘴)   —— 6 段方形阶梯收分塔，高 420m
    4) 东方明珠 Oriental Pearl (上海浦东)     —— 4 段八角鼓交替宽窄堆叠，模拟球体串与天线，高 468m
    5) 鸟巢 国家体育场 Bird's Nest (北京奥运) —— 八角椭圆环 + 内孔 extrude=1，高 69m
  已知失真：真实结构里的斜腿、球体、扭转为不可能任务（引擎不支持 Collada/glTF/曲面），已按形态尽量近似。
  坐标为 WGS84 经纬度，高程单位米，relativeToGround（本环境无 DEM 约等于离椭球）。位置与尺度为近似演示值。
-->
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>中国名筑 3D 演示集</name>
    <open>1</open>

    <LookAt>
      <longitude>116.4614</longitude>
      <latitude>39.9100</latitude>
      <altitude>800</altitude>
      <heading>0</heading>
      <tilt>50</tilt>
      <range>3000</range>
      <altitudeMode>relativeToGround</altitudeMode>
    </LookAt>

    <!-- ============= 样式（Phase 3：按要素 name 关联） ============= -->
    <Style id="cctvBody">
      <LineStyle><color>ff4060a0</color><width>1.5</width></LineStyle>
      <PolyStyle><color>cc8c6e5a</color></PolyStyle>
    </Style>
    <Style id="zun">
      <LineStyle><color>ff0000a0</color><width>1.5</width></LineStyle>
      <PolyStyle><color>ffd4af37</color></PolyStyle>
    </Style>
    <Style id="jinmao">
      <LineStyle><color>ff000080</color><width>1.5</width></LineStyle>
      <PolyStyle><color>ff3373b8</color></PolyStyle>
    </Style>
    <Style id="pearl">
      <LineStyle><color>ff8000c0</color><width>1.5</width></LineStyle>
      <PolyStyle><color>ff7e5bc2</color></PolyStyle>
    </Style>
    <Style id="nest">
      <LineStyle><color>ff0000cc</color><width>1.5</width></LineStyle>
      <PolyStyle><color>ff2222cc</color></PolyStyle>
    </Style>

    <!-- ============= 1. CCTV 央视大楼（沿用已验证几何） ============= -->
    <Placemark>
      <name>CCTV Tower A</name>
      <styleUrl>#cctvBody</styleUrl>
      <Polygon>
        <extrude>1</extrude><altitudeMode>relativeToGround</altitudeMode>
        <outerBoundaryIs><LinearRing><coordinates>
          116.487400,39.915850,163 116.487900,39.915850,163
          116.487900,39.916250,163 116.487400,39.916250,163
          116.487400,39.915850,163
        </coordinates></LinearRing></outerBoundaryIs>
      </Polygon>
    </Placemark>
    <Placemark>
      <name>CCTV Tower B</name>
      <styleUrl>#cctvBody</styleUrl>
      <Polygon>
        <extrude>1</extrude><altitudeMode>relativeToGround</altitudeMode>
        <outerBoundaryIs><LinearRing><coordinates>
          116.488300,39.916450,163 116.488800,39.916450,163
          116.488800,39.916850,163 116.488300,39.916850,163
          116.488300,39.916450,163
        </coordinates></LinearRing></outerBoundaryIs>
      </Polygon>
    </Placemark>
    <Placemark>
      <name>CCTV Sky Bridge</name>
      <styleUrl>#cctvBody</styleUrl>
      <Polygon>
        <extrude>0</extrude><altitudeMode>relativeToGround</altitudeMode>
        <outerBoundaryIs><LinearRing><coordinates>
          116.487400,39.915850,163 116.488800,39.915850,163
          116.488800,39.916850,163 116.487400,39.916850,163
          116.487400,39.915850,163
        </coordinates></LinearRing></outerBoundaryIs>
        <innerBoundaryIs><LinearRing><coordinates>
          116.487900,39.916250,163 116.488300,39.916250,163
          116.488300,39.916450,163 116.487900,39.916450,163
          116.487900,39.916250,163
        </coordinates></LinearRing></innerBoundaryIs>
      </Polygon>
    </Placemark>

